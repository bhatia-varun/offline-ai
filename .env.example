# Backend and UI use the LiteLLM OpenAI-compatible endpoint.
LITELLM_BASE_URL=http://127.0.0.1:4000/v1
LITELLM_API_KEY=local-demo-key
GENERAL_MODEL=general
AGENT_MODEL=agent
OLLAMA_BASE_URL=http://127.0.0.1:11434
EMBEDDING_MODEL=nomic-embed-text
CHROMA_PATH=rag/chroma

# Optional: only needed with config/litellm.hybrid.yaml.
# OPENAI_API_KEY=sk-...
